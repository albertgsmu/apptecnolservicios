{
  "name": "apptecnolservicios",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "dev:server": "node server/server.js",
    "start": "node server/server.js",
    "build": "tsc -b && vite build",
    "db:generate": "prisma generate",
    "db:check": "node scripts/check-database.mjs",
    "db:storage": "node scripts/database-storage.mjs",
    "db:overview": "node scripts/check-dashboard.mjs",
    "test:media:postgres": "node scripts/verify-database-media.mjs",
    "db:push": "prisma db push",
    "db:migrate:auth:sqlite": "node scripts/migrate-auth-security.mjs --target=sqlite",
    "db:migrate:auth:postgres": "node scripts/migrate-auth-security.mjs --target=postgres",
    "auth:bootstrap:sqlite": "node scripts/bootstrap-manager.mjs --target=sqlite",
    "auth:bootstrap:postgres": "node scripts/bootstrap-manager.mjs --target=postgres",
    "test:auth": "node --test server/auth-security.test.js",
    "test:auth-flow": "node --test server/auth-flow.test.js",
    "test:panel": "node --test server/panel-browser.test.js",
    "test:database": "node --test server/database-readiness.test.js",
    "test:access": "node --test server/user-access.test.js",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "deploy:check": "node scripts/deploy-check.mjs",
    "db:reset": "prisma migrate reset --force",
    "db:reset:seed": "prisma migrate reset --force && node prisma/seed.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
