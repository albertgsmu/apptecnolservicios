DATABASE_URL="postgresql://user:password@localhost:5432/jp_mantenimiento?schema=public"
MFA_ENCRYPTION_KEY="replace-with-a-random-32-byte-base64-key"
PORT=3003
# Solo pruebas locales: false permite entrar al Gerente sin TOTP. Producción siempre exige MFA.
MANAGER_MFA_REQUIRED=true
# Opcional: carpeta temporal para recibir archivos. Los adjuntos se guardan en la base.
# ORDER_UPLOAD_DIR=/ruta/temporal/order-media
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5177"
VITE_API_URL="http://localhost:3003"

# Azure or another production host: configure these in its secret store.
# DATABASE_URL="postgresql://user:password@HOST:5432/jp_mantenimiento?sslmode=require"
# MFA_ENCRYPTION_KEY="a-random-32-byte-base64-key"
# ALLOWED_ORIGINS="https://<frontend-domain>"
# VITE_API_URL="https://<backend-domain>"
# TRUST_PROXY_HOPS=1
# Publicación conjunta de la web y API: compilar con npm run build:web.
# SERVE_FRONTEND=true
# APP_ORIGIN=https://<tu-dominio>
# Render incorpora su RENDER_EXTERNAL_URL automáticamente a los orígenes permitidos.
